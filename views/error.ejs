<div class="min-h-[60vh] flex items-center justify-center p-4">
  <div class="glass p-8 max-w-md w-full text-center rounded-3xl border border-white/10 shadow-2xl">
    <div class="w-16 h-16 rounded-2xl bg-rose-500/15 border border-rose-500/30 flex items-center justify-center mx-auto mb-4 text-rose-400">
      <i class="ph-duotone ph-warning-circle text-3xl"></i>
    </div>
    <h2 class="text-xl font-bold text-white mb-2"><%= title || 'Something went wrong' %></h2>
    <p class="text-white/50 text-xs mb-6"><%= message || 'An unexpected error occurred. Please try again.' %></p>
    <a href="/" class="btn-primary inline-flex justify-center text-xs">
      <i class="ph-bold ph-house text-base"></i>
      <span>Back to Dashboard</span>
    </a>
  </div>
</div>

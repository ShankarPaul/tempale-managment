<!-- Staff Profile & Payroll History -->
<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
  <!-- Staff Profile Card -->
  <div class="glass p-6 text-center rounded-2xl flex flex-col justify-between">
    <div>
      <div class="w-24 h-24 bg-gradient-to-br from-amber-400 to-orange-500 rounded-3xl flex items-center justify-center text-white text-4xl font-bold mx-auto mb-4 shadow-xl border border-amber-300/30">
        <%= staff.name.charAt(0).toUpperCase() %>
      </div>
      <h2 class="text-xl font-bold text-white"><%= staff.name %></h2>
      <span class="inline-block mt-1 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/15 text-amber-300 border border-amber-500/20">
        <%= staff.role %>
      </span>

      <div class="mt-6 space-y-2.5 text-left text-xs text-white/80">
        <div class="flex items-center gap-3 p-3 rounded-xl bg-white/5 border border-white/5">
          <i class="ph-duotone ph-phone text-amber-400 text-lg"></i>
          <span><%= staff.phone || 'N/A' %></span>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-xl bg-white/5 border border-white/5">
          <i class="ph-duotone ph-calendar text-amber-400 text-lg"></i>
          <span>Joined: <%= new Date(staff.date_of_joining).toLocaleDateString('en-IN') %></span>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-xl bg-white/5 border border-white/5">
          <i class="ph-duotone ph-identification-card text-amber-400 text-lg"></i>
          <span>Aadhaar: <%= staff.aadhaar || 'N/A' %></span>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-300">
          <i class="ph-duotone ph-currency-inr text-emerald-400 text-lg"></i>
          <span class="font-bold text-sm font-mono">₹<%= parseFloat(staff.base_salary).toLocaleString('en-IN') %> / month</span>
        </div>
        <% if(staff.bank_name) { %>
          <div class="flex items-center gap-3 p-3 rounded-xl bg-white/5 border border-white/5">
            <i class="ph-duotone ph-bank text-amber-400 text-lg"></i>
            <span><%= staff.bank_name %> <%= staff.bank_account ? `(${staff.bank_account})` : '' %></span>
          </div>
        <% } %>
        <% if(staff.upi_id) { %>
          <div class="flex items-center gap-3 p-3 rounded-xl bg-white/5 border border-white/5">
            <i class="ph-duotone ph-device-mobile text-amber-400 text-lg"></i>
            <span><%= staff.upi_id %></span>
          </div>
        <% } %>
      </div>
    </div>

    <div class="mt-6 flex gap-2">
      <button onclick="document.getElementById('advanceModal').classList.add('active')" class="flex-1 btn-secondary text-xs justify-center py-2.5">
        <i class="ph-duotone ph-wallet text-base"></i>
        <span>Record Advance</span>
      </button>
    </div>
  </div>

  <!-- Payroll History & Advance Ledger -->
  <div class="glass p-6 xl:col-span-2 rounded-2xl">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-bold text-white text-base flex items-center gap-2">
        <i class="ph-duotone ph-money text-amber-400 text-lg"></i>
        <span>Payroll History</span>
      </h3>
      <span class="text-xs text-white/40"><%= payroll.length %> records</span>
    </div>

    <% if(!payroll.length) { %>
      <div class="text-center py-8 text-white/40">
        <i class="ph-duotone ph-calendar-x text-3xl mb-1 text-white/20"></i>
        <p class="text-xs">No payroll disbursements generated yet for this staff member.</p>
      </div>
    <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-white/5 border-b border-white/10">
          <tr>
            <th class="text-left px-4 py-3 text-xs font-semibold text-white/50 uppercase tracking-wider">Month</th>
            <th class="text-right px-4 py-3 text-xs font-semibold text-white/50 uppercase tracking-wider">Days Present</th>
            <th class="text-right px-4 py-3 text-xs font-semibold text-white/50 uppercase tracking-wider">Advance Deducted</th>
            <th class="text-right px-4 py-3 text-xs font-semibold text-white/50 uppercase tracking-wider">Net Salary</th>
            <th class="text-center px-4 py-3 text-xs font-semibold text-white/50 uppercase tracking-wider">Status</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          <% payroll.forEach(p => { %>
          <tr class="hover:bg-white/5 transition-colors">
            <td class="px-4 py-3.5 font-medium text-white/90 text-xs">
              <%= new Date(p.month+'-01').toLocaleString('en-IN', {month:'long', year:'numeric'}) %>
            </td>
            <td class="px-4 py-3.5 text-right text-xs font-mono text-white/70">
              <%= p.days_present %> / <%= p.days_in_month %>
            </td>
            <td class="px-4 py-3.5 text-right text-xs font-mono text-rose-400">
              <%= parseFloat(p.advance_deduction) > 0 ? `₹${parseFloat(p.advance_deduction).toLocaleString('en-IN')}` : '—' %>
            </td>
            <td class="px-4 py-3.5 text-right font-bold text-emerald-400 font-mono text-sm">
              ₹<%= parseFloat(p.net_salary).toLocaleString('en-IN') %>
            </td>
            <td class="px-4 py-3.5 text-center">
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold <%= p.payment_status === 'Paid' ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30' : 'bg-amber-500/15 text-amber-300 border border-amber-500/30' %>">
                <%= p.payment_status %>
              </span>
            </td>
            <td class="px-4 py-3.5 text-right">
              <a href="/staff/salary-slip/<%= staff.id %>/<%= p.month %>" target="_blank" class="px-2.5 py-1 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/20 text-xs font-semibold inline-flex items-center gap-1 transition-colors">
                <i class="ph-bold ph-printer"></i>
                <span>Slip</span>
              </a>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>

    <!-- Advance Salary Ledger -->
    <div class="mt-8 pt-6 border-t border-white/10">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-bold text-white text-base flex items-center gap-2">
          <i class="ph-duotone ph-hand-coins text-amber-400 text-lg"></i>
          <span>Advance Salary Ledger</span>
        </h3>
        <span class="text-xs text-white/40"><%= advances.length %> advances</span>
      </div>

      <% if(!advances.length) { %>
        <p class="text-white/40 text-xs text-center py-4">No advance salary recorded for this staff member</p>
      <% } else { %>
      <div class="space-y-2">
        <% advances.forEach(a => { %>
        <div class="flex justify-between items-center p-3 rounded-xl <%= a.deducted ? 'bg-emerald-500/10 border border-emerald-500/20' : 'bg-rose-500/10 border border-rose-500/20' %>">
          <div>
            <p class="font-semibold text-xs text-white"><%= a.reason || 'Advance Salary' %></p>
            <p class="text-[11px] text-white/40 mt-0.5"><%= new Date(a.date_given).toLocaleDateString('en-IN') %></p>
          </div>
          <div class="text-right">
            <p class="font-bold font-mono text-sm <%= a.deducted ? 'text-emerald-400' : 'text-rose-400' %>">
              ₹<%= parseFloat(a.amount).toLocaleString('en-IN') %>
            </p>
            <p class="text-[10px] <%= a.deducted ? 'text-emerald-400/80' : 'text-rose-400/80' %>">
              <%= a.deducted ? `✓ Deducted (${a.deducted_month})` : '⚠️ Pending deduction' %>
            </p>
          </div>
        </div>
        <% }); %>
      </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Advance Modal -->
<div class="modal-overlay" id="advanceModal">
  <div class="modal-box max-w-md w-full">
    <div class="flex justify-between items-center mb-5 pb-3 border-b border-white/10">
      <div class="flex items-center gap-2">
        <div class="w-9 h-9 rounded-xl bg-amber-500/20 flex items-center justify-center text-amber-400">
          <i class="ph-duotone ph-wallet text-xl"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-white">Record Advance Salary</h3>
          <p class="text-xs text-white/40">Advance given to <%= staff.name %></p>
        </div>
      </div>
      <button onclick="document.getElementById('advanceModal').classList.remove('active')" class="text-white/40 hover:text-white transition-colors">
        <i class="ph-bold ph-x text-lg"></i>
      </button>
    </div>

    <form id="advanceForm" class="space-y-4">
      <input type="hidden" name="staff_id" value="<%= staff.id %>">
      <div>
        <label class="form-label">Amount (₹) *</label>
        <input type="number" name="amount" required min="1" placeholder="0" class="form-input font-mono">
      </div>
      <div>
        <label class="form-label">Date Given *</label>
        <input type="date" name="date_given" required class="form-input" value="<%= new Date().toISOString().split('T')[0] %>">
      </div>
      <div>
        <label class="form-label">Reason</label>
        <input type="text" name="reason" class="form-input" placeholder="e.g. Medical emergency, family function">
      </div>
      <div class="flex gap-3 pt-2">
        <button type="submit" class="btn-primary flex-1 justify-center">
          <i class="ph-bold ph-floppy-disk text-base"></i>
          <span>Record Advance</span>
        </button>
        <button type="button" onclick="document.getElementById('advanceModal').classList.remove('active')" class="btn-secondary">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>

<script>
document.getElementById('advanceForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(this));
  try {
    const res = await fetch('/staff/advance', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(data)
    });
    const result = await res.json();
    if (result.success) {
      showToast('Advance salary recorded!');
      setTimeout(() => location.reload(), 800);
    } else {
      Swal.fire({ icon: 'error', title: 'Error', text: result.message, background: '#1e1b4b', color: '#fff' });
    }
  } catch (err) {
    Swal.fire({ icon: 'error', title: 'Network Error', text: err.message, background: '#1e1b4b', color: '#fff' });
  }
});
</script>

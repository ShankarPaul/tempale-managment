<!-- Tabs + Actions -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
  <div class="flex glass rounded-xl p-1">
    <a href="/donations?type=cash" class="px-5 py-2 rounded-lg text-sm font-semibold transition-all <%= type==='cash'?'bg-amber-500 text-white shadow-lg':'text-white/50 hover:text-white' %>">
      <i class="ph-duotone ph-currency-inr"></i> Cash Donations
    </a>
    <a href="/donations?type=commodity" class="px-5 py-2 rounded-lg text-sm font-semibold transition-all <%= type==='commodity'?'bg-blue-500 text-white shadow-lg':'text-white/50 hover:text-white' %>">
      <i class="ph-duotone ph-package"></i> Commodity
    </a>
  </div>
  <div class="flex gap-2">
    <a href="/donations/donors" class="btn-secondary text-sm py-2 px-4"><i class="ph-duotone ph-address-book text-base"></i> Donors</a>
    <% if(type==='cash') { %>
    <button onclick="document.getElementById('cashModal').classList.add('active')" class="btn-primary text-sm py-2 px-4">
      <i class="ph-bold ph-plus text-base"></i> Add Cash Donation
    </button>
    <% } else { %>
    <button onclick="document.getElementById('commodityModal').classList.add('active')" class="btn-primary text-sm py-2 px-4">
      <i class="ph-bold ph-plus text-base"></i> Add Commodity
    </button>
    <% } %>
  </div>
</div>

<!-- Donations Table -->
<div class="glass-card overflow-hidden">
  <div class="overflow-x-auto">
    <table class="data-table">
      <thead>
        <tr>
          <% if(type==='cash') { %>
          <th>Receipt #</th><th>Donor</th><th>Amount</th><th>Mode</th><th>Purpose</th><th>Date</th><th>80G</th><th></th>
          <% } else { %>
          <th>Receipt #</th><th>Donor</th><th>Item</th><th>Quantity</th><th>Date</th><th></th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% if(!donations.length) { %>
        <tr><td colspan="8" class="text-center py-16">
          <div class="flex flex-col items-center gap-3">
            <div class="w-14 h-14 rounded-full glass flex items-center justify-center">
              <i class="ph-duotone ph-hand-heart text-3xl text-white/20"></i>
            </div>
            <p class="text-white/30 font-semibold">No donations recorded yet</p>
          </div>
        </td></tr>
        <% } %>
        <% donations.forEach(d => { %>
        <tr>
          <% if(type==='cash') { %>
          <td><span class="font-mono text-amber-400 font-bold text-xs"><%= d.receipt_number %></span></td>
          <td>
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-full bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center text-white font-bold text-xs flex-shrink-0"><%= d.donor_name.charAt(0).toUpperCase() %></div>
              <div>
                <p class="text-white/85 font-semibold text-sm"><%= d.donor_name %></p>
                <p class="text-white/30 text-xs"><%= d.donor_phone || '' %></p>
              </div>
            </div>
          </td>
          <td><span class="text-green-400 font-bold">₹<%= parseFloat(d.amount).toLocaleString('en-IN') %></span></td>
          <td><span class="badge badge-amber"><%= d.payment_mode %></span></td>
          <td class="text-white/40 text-xs max-w-28 truncate"><%= d.purpose || '—' %></td>
          <td class="text-white/40 text-xs whitespace-nowrap"><%= new Date(d.donation_date).toLocaleDateString('en-IN') %></td>
          <td><%= d.is_80g ? '<span class="badge badge-green">✓ 80G</span>' : '<span class="text-white/20 text-xs">—</span>' %></td>
          <td>
            <a href="/donations/receipt/cash/<%= d.id %>" target="_blank" class="flex items-center gap-1 text-amber-400 hover:text-amber-300 text-xs font-semibold whitespace-nowrap">
              <i class="ph-bold ph-printer"></i> Receipt
            </a>
          </td>
          <% } else { %>
          <td><span class="font-mono text-blue-400 font-bold text-xs"><%= d.receipt_number %></span></td>
          <td class="text-white/85 font-semibold text-sm"><%= d.donor_name %></td>
          <td class="text-white/70"><%= d.item_name %></td>
          <td><span class="text-blue-400 font-bold"><%= parseFloat(d.quantity) %> <%= d.unit %></span></td>
          <td class="text-white/40 text-xs whitespace-nowrap"><%= new Date(d.donation_date).toLocaleDateString('en-IN') %></td>
          <td>
            <a href="/donations/receipt/commodity/<%= d.id %>" target="_blank" class="flex items-center gap-1 text-amber-400 hover:text-amber-300 text-xs font-semibold">
              <i class="ph-bold ph-printer"></i> Receipt
            </a>
          </td>
          <% } %>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<!-- Cash Donation Modal -->
<div class="modal-overlay" id="cashModal">
  <div class="modal-box max-w-2xl">
    <div class="flex justify-between items-center mb-6">
      <h3 class="text-xl font-bold text-white flex items-center gap-2">
        <span class="w-9 h-9 rounded-xl bg-green-500/20 flex items-center justify-center"><i class="ph-duotone ph-currency-inr text-green-400 text-xl"></i></span>
        Record Cash Donation
      </h3>
      <button onclick="document.getElementById('cashModal').classList.remove('active')" class="text-white/40 hover:text-white w-8 h-8 rounded-xl hover:bg-white/10 flex items-center justify-center"><i class="ph-bold ph-x text-lg"></i></button>
    </div>
    <form id="cashDonationForm" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="sm:col-span-2">
        <label class="form-label">Search Existing Donor</label>
        <div class="relative">
          <i class="ph-duotone ph-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-white/30 text-lg"></i>
          <input type="text" id="donorSearch" placeholder="Search by name or mobile..." class="form-input" style="padding-left:40px" autocomplete="off">
        </div>
        <div id="donorSuggestions" class="hidden absolute bg-slate-900 border border-white/10 rounded-xl shadow-2xl mt-1 z-50 max-h-48 overflow-y-auto w-80"></div>
      </div>
      <input type="hidden" name="donor_id" id="donorId">
      <div>
        <label class="form-label">Donor Name *</label>
        <input type="text" name="donor_name" id="donorName" required class="form-input" placeholder="Full name">
      </div>
      <div>
        <label class="form-label">Phone</label>
        <input type="tel" name="donor_phone" id="donorPhone" class="form-input" placeholder="Mobile number">
      </div>
      <div>
        <label class="form-label">Amount (₹) *</label>
        <input type="number" name="amount" required min="1" class="form-input" placeholder="0.00">
      </div>
      <div>
        <label class="form-label">Payment Mode *</label>
        <select name="payment_mode" required class="form-input" id="paymentMode" onchange="toggleCheque(this.value)">
          <option value="Cash">Cash</option>
          <option value="UPI">UPI / QR Code</option>
          <option value="Card">Card</option>
          <option value="Net Banking">Net Banking</option>
          <option value="Cheque">Cheque</option>
        </select>
      </div>
      <div id="chequeField" class="hidden">
        <label class="form-label">Cheque Number</label>
        <input type="text" name="cheque_number" class="form-input">
      </div>
      <div>
        <label class="form-label">Transaction Reference</label>
        <input type="text" name="transaction_ref" class="form-input" placeholder="UTR / Ref No.">
      </div>
      <div>
        <label class="form-label">Date *</label>
        <input type="date" name="donation_date" required class="form-input" value="<%= new Date().toISOString().split('T')[0] %>">
      </div>
      <div class="sm:col-span-2">
        <label class="form-label">Purpose</label>
        <input type="text" name="purpose" class="form-input" placeholder="General, Navratri, Bhandara...">
      </div>
      <div class="sm:col-span-2 flex items-center gap-3">
        <input type="checkbox" name="is_80g" value="true" id="is80g" class="w-5 h-5 accent-amber-500 rounded">
        <label for="is80g" class="text-sm font-semibold text-white/60">Issue 80G Tax Exemption Certificate</label>
      </div>
      <div class="sm:col-span-2 flex gap-3 pt-1">
        <button type="submit" class="btn-primary flex-1 justify-center py-3"><i class="ph-bold ph-check-circle text-base"></i> Save & Print Receipt</button>
        <button type="button" onclick="document.getElementById('cashModal').classList.remove('active')" class="btn-secondary py-3">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- Commodity Modal -->
<div class="modal-overlay" id="commodityModal">
  <div class="modal-box max-w-xl">
    <div class="flex justify-between items-center mb-6">
      <h3 class="text-xl font-bold text-white flex items-center gap-2">
        <span class="w-9 h-9 rounded-xl bg-blue-500/20 flex items-center justify-center"><i class="ph-duotone ph-package text-blue-400 text-xl"></i></span>
        Commodity Donation
      </h3>
      <button onclick="document.getElementById('commodityModal').classList.remove('active')" class="text-white/40 hover:text-white w-8 h-8 rounded-xl hover:bg-white/10 flex items-center justify-center"><i class="ph-bold ph-x text-lg"></i></button>
    </div>
    <form id="commodityForm" class="grid grid-cols-2 gap-4">
      <div class="col-span-2">
        <label class="form-label">Donor / Shopkeeper Name *</label>
        <input type="text" name="donor_name" required class="form-input" placeholder="Shop or person name">
      </div>
      <div>
        <label class="form-label">Phone</label>
        <input type="tel" name="donor_phone" class="form-input">
      </div>
      <div>
        <label class="form-label">Date *</label>
        <input type="date" name="donation_date" required class="form-input" value="<%= new Date().toISOString().split('T')[0] %>">
      </div>
      <div>
        <label class="form-label">Item *</label>
        <select name="item_name" required class="form-input">
          <option value="">Select item</option>
          <% inventoryItems.forEach(item => { %><option value="<%= item.item_name %>"><%= item.item_name %> (<%= item.unit %>)</option><% }); %>
          <option value="Other">Other</option>
        </select>
      </div>
      <div>
        <label class="form-label">Quantity *</label>
        <input type="number" name="quantity" required step="0.01" min="0.01" class="form-input" placeholder="e.g. 50">
      </div>
      <div>
        <label class="form-label">Unit *</label>
        <select name="unit" required class="form-input">
          <option value="KG">KG</option><option value="Grams">Grams</option><option value="Quintals">Quintals</option>
          <option value="Liters">Liters</option><option value="Bags">Bags</option><option value="Packets">Packets</option><option value="Pieces">Pieces</option>
        </select>
      </div>
      <div>
        <label class="form-label">Est. Value (₹)</label>
        <input type="number" name="estimated_value" class="form-input" placeholder="Optional">
      </div>
      <div class="col-span-2">
        <label class="form-label">Notes</label>
        <input type="text" name="notes" class="form-input" placeholder="Any additional notes...">
      </div>
      <div class="col-span-2 flex gap-3">
        <button type="submit" class="btn-primary flex-1 justify-center py-3"><i class="ph-bold ph-check-circle text-base"></i> Save & Update Stock</button>
        <button type="button" onclick="document.getElementById('commodityModal').classList.remove('active')" class="btn-secondary py-3">Cancel</button>
      </div>
    </form>
  </div>
</div>

<script>
let donorSearchTimeout;
document.getElementById('donorSearch').addEventListener('input', function() {
  clearTimeout(donorSearchTimeout);
  const q = this.value.trim();
  const div = document.getElementById('donorSuggestions');
  if (q.length < 2) { div.classList.add('hidden'); return; }
  donorSearchTimeout = setTimeout(async () => {
    const res = await fetch(`/donations/search-donors?q=${encodeURIComponent(q)}`);
    const donors = await res.json();
    if (!donors.length) { div.classList.add('hidden'); return; }
    div.innerHTML = donors.map(d => `<div onclick="selectDonor(${d.id},'${d.name}','${d.phone||''}','${d.shop_name||''}')" class="px-4 py-3 hover:bg-white/5 cursor-pointer border-b border-white/5 last:border-0"><p class="font-semibold text-white/90 text-sm">${d.shop_name || d.name}</p><p class="text-white/30 text-xs">${d.category} · ${d.phone||''}</p></div>`).join('');
    div.classList.remove('hidden');
  }, 300);
});

function selectDonor(id, name, phone, shop) {
  document.getElementById('donorId').value = id;
  document.getElementById('donorName').value = shop || name;
  document.getElementById('donorPhone').value = phone;
  document.getElementById('donorSearch').value = shop || name;
  document.getElementById('donorSuggestions').classList.add('hidden');
}

function toggleCheque(mode) {
  document.getElementById('chequeField').classList.toggle('hidden', mode !== 'Cheque');
}

document.getElementById('cashDonationForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(this));
  data.is_80g = document.getElementById('is80g').checked ? 'true' : 'false';
  const res = await fetch('/donations/cash', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
  const result = await res.json();
  if (result.success) {
    document.getElementById('cashModal').classList.remove('active'); this.reset();
    swalDark({ icon:'success', title:'Donation Saved!', text:`Receipt: ${result.receipt.receipt_number}`, showCancelButton:true, confirmButtonText:'🖨️ Print Receipt', cancelButtonText:'Close' }).then(r => {
      if(r.isConfirmed) window.open(`/donations/receipt/cash/${result.receipt.id}`, '_blank');
      location.reload();
    });
  } else swalDark({ icon:'error', title:'Error', text: result.message });
});

document.getElementById('commodityForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(this));
  const res = await fetch('/donations/commodity', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
  const result = await res.json();
  if (result.success) {
    document.getElementById('commodityModal').classList.remove('active'); this.reset();
    swalDark({ icon:'success', title:'Saved!', text:'Stock updated automatically.', showCancelButton:true, confirmButtonText:'🖨️ Print Receipt', cancelButtonText:'Close' }).then(r => {
      if(r.isConfirmed) window.open(`/donations/receipt/commodity/${result.receipt.id}`, '_blank');
      location.reload();
    });
  } else swalDark({ icon:'error', title:'Error', text: result.message });
});
</script>

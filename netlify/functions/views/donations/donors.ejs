<!-- Donor Directory Header -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
  <div>
    <p class="text-white/40 text-xs"><%= donors.length %> registered donors & regular patrons</p>
  </div>
  <button onclick="document.getElementById('addDonorModal').classList.add('active')" class="btn-primary text-sm">
    <i class="ph-bold ph-user-plus text-base"></i>
    <span>Add Donor / Shopkeeper</span>
  </button>
</div>

<!-- Search Bar -->
<div class="glass p-3 mb-6 rounded-2xl flex items-center gap-3">
  <i class="ph-bold ph-magnifying-glass text-white/40 text-lg ml-2"></i>
  <input type="text" id="donorSearchInput" placeholder="Search patrons by name, shop name, or phone number..." class="w-full bg-transparent text-white text-sm outline-none placeholder-white/30" oninput="filterDonors(this.value)">
</div>

<!-- Category Filter Pills -->
<div class="flex flex-wrap gap-2 mb-6">
  <% ['All','Regular Shopkeeper','Devotee','Trustee','Corporate'].forEach((cat, i) => { %>
  <button onclick="filterCat('<%= cat %>')" class="cat-tab px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all <%= i === 0 ? 'bg-amber-500 text-white shadow-lg shadow-amber-500/20 active-tab' : 'bg-white/5 border border-white/10 text-white/70 hover:bg-white/10 hover:text-white' %>" data-cat="<%= cat %>">
    <%= cat %>
  </button>
  <% }); %>
</div>

<!-- Donors Grid -->
<% if (donors.length === 0) { %>
  <div class="glass p-16 text-center text-white/40 rounded-2xl">
    <div class="w-16 h-16 rounded-2xl bg-amber-500/10 flex items-center justify-center mx-auto mb-3 text-amber-400">
      <i class="ph-duotone ph-address-book text-4xl"></i>
    </div>
    <p class="text-base font-semibold text-white/80">No donors recorded yet</p>
    <p class="text-xs text-white/40 mt-1">Click "Add Donor / Shopkeeper" to build the temple patron directory.</p>
  </div>
<% } %>

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5" id="donorGrid">
  <% donors.forEach(d => {
    const isTrustee = d.category === 'Trustee';
    const isShop = d.category === 'Regular Shopkeeper';
    const badgeStyle = isTrustee
      ? 'bg-purple-500/15 text-purple-300 border-purple-500/30'
      : isShop
      ? 'bg-blue-500/15 text-blue-300 border-blue-500/30'
      : 'bg-amber-500/15 text-amber-300 border-amber-500/30';
  %>
  <div class="glass-card p-5 rounded-2xl transition-all donor-card" data-cat="<%= d.category %>" data-search="<%= (d.name + ' ' + (d.shop_name||'') + ' ' + (d.phone||'') + ' ' + d.category).toLowerCase() %>">
    <div class="flex items-start justify-between mb-4">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 bg-gradient-to-br from-amber-400 to-orange-500 rounded-2xl flex items-center justify-center text-white font-bold shadow-md flex-shrink-0">
          <%= d.name.charAt(0).toUpperCase() %>
        </div>
        <div>
          <h4 class="font-bold text-white text-sm leading-snug"><%= d.name %></h4>
          <% if(d.shop_name) { %>
            <p class="text-[11px] text-amber-300/80 mt-0.5 flex items-center gap-1">
              <i class="ph-duotone ph-storefront"></i> <%= d.shop_name %>
            </p>
          <% } %>
        </div>
      </div>
      <span class="text-[11px] font-medium px-2 py-0.5 rounded-full border <%= badgeStyle %>">
        <%= isShop ? '🏪 Shop' : isTrustee ? '⭐ Trustee' : '🙏 Devotee' %>
      </span>
    </div>

    <div class="space-y-2 text-xs text-white/60">
      <% if(d.phone) { %>
        <div class="flex items-center gap-2">
          <i class="ph-duotone ph-phone text-amber-400"></i>
          <span><%= d.phone %></span>
        </div>
      <% } %>
      <% if(d.address) { %>
        <div class="flex items-center gap-2 text-white/40">
          <i class="ph-duotone ph-map-pin text-amber-400/70"></i>
          <span class="truncate"><%= d.address.substring(0, 42) %></span>
        </div>
      <% } %>
      <div class="pt-3 mt-3 border-t border-white/10 flex justify-between items-center">
        <span class="text-white/40 text-[11px] uppercase tracking-wider">Total Donated</span>
        <span class="font-bold text-emerald-400 font-mono text-sm">₹<%= parseFloat(d.total_donated || 0).toLocaleString('en-IN') %></span>
      </div>
      <% if(d.is_80g_eligible) { %>
        <div class="pt-1">
          <span class="px-2 py-0.5 rounded-md bg-blue-500/15 text-blue-300 border border-blue-500/30 text-[10px] font-semibold inline-block">
            📋 80G Certified
          </span>
        </div>
      <% } %>
    </div>
  </div>
  <% }); %>
</div>

<!-- Add Donor Modal -->
<div class="modal-overlay" id="addDonorModal">
  <div class="modal-box max-w-lg w-full">
    <div class="flex justify-between items-center mb-5 pb-3 border-b border-white/10">
      <div class="flex items-center gap-2">
        <div class="w-9 h-9 rounded-xl bg-amber-500/20 flex items-center justify-center text-amber-400">
          <i class="ph-duotone ph-user-plus text-xl"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-white">Add Donor / Shopkeeper</h3>
          <p class="text-xs text-white/40">Register a new donor profile in the temple ledger</p>
        </div>
      </div>
      <button onclick="document.getElementById('addDonorModal').classList.remove('active')" class="text-white/40 hover:text-white transition-colors">
        <i class="ph-bold ph-x text-lg"></i>
      </button>
    </div>

    <form id="addDonorForm" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="col-span-1 sm:col-span-2">
        <label class="form-label">Full Name *</label>
        <input type="text" name="name" required class="form-input" placeholder="e.g. Ramesh Kumar">
      </div>
      <div>
        <label class="form-label">Category *</label>
        <select name="category" required class="form-input">
          <option value="Devotee">🙏 Devotee</option>
          <option value="Regular Shopkeeper">🏪 Regular Shopkeeper</option>
          <option value="Trustee">⭐ Trustee</option>
          <option value="Corporate">🏢 Corporate</option>
        </select>
      </div>
      <div>
        <label class="form-label">Phone Number</label>
        <input type="tel" name="phone" class="form-input" placeholder="e.g. 9876543210">
      </div>
      <div class="col-span-1 sm:col-span-2">
        <label class="form-label">Shop / Business Name (if vendor/shopkeeper)</label>
        <input type="text" name="shop_name" class="form-input" placeholder="e.g. Balaji Sweets & Flowers">
      </div>
      <div>
        <label class="form-label">PAN Number</label>
        <input type="text" name="pan_number" class="form-input font-mono uppercase" placeholder="ABCDE1234F">
      </div>
      <div class="flex items-center gap-2 pt-6">
        <input type="checkbox" name="is_80g_eligible" value="true" id="donor80g" class="w-4 h-4 rounded accent-amber-500 cursor-pointer">
        <label for="donor80g" class="text-xs font-semibold text-white/80 cursor-pointer">Tax Exemption 80G</label>
      </div>
      <div class="col-span-1 sm:col-span-2">
        <label class="form-label">Postal Address</label>
        <textarea name="address" class="form-input h-16 resize-none" placeholder="Residential or commercial address"></textarea>
      </div>
      <div class="col-span-1 sm:col-span-2 flex gap-3 pt-2">
        <button type="submit" class="btn-primary flex-1 justify-center">
          <i class="ph-bold ph-floppy-disk text-base"></i>
          <span>Save Donor</span>
        </button>
        <button type="button" onclick="document.getElementById('addDonorModal').classList.remove('active')" class="btn-secondary">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function filterDonors(q) {
  const query = q.toLowerCase();
  document.querySelectorAll('.donor-card').forEach(c => {
    c.style.display = c.dataset.search.includes(query) ? '' : 'none';
  });
}

function filterCat(cat) {
  document.querySelectorAll('.donor-card').forEach(c => {
    c.style.display = (cat === 'All' || c.dataset.cat === cat) ? '' : 'none';
  });
  document.querySelectorAll('.cat-tab').forEach(btn => {
    if (btn.dataset.cat === cat) {
      btn.className = 'cat-tab px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all bg-amber-500 text-white shadow-lg shadow-amber-500/20 active-tab';
    } else {
      btn.className = 'cat-tab px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all bg-white/5 border border-white/10 text-white/70 hover:bg-white/10 hover:text-white';
    }
  });
}

document.getElementById('addDonorForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(this));
  data.is_80g_eligible = document.getElementById('donor80g').checked ? 'true' : 'false';
  try {
    const res = await fetch('/donations/donors', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(data)
    });
    const result = await res.json();
    if (result.success) {
      showToast('Donor added successfully!');
      setTimeout(() => location.reload(), 800);
    } else {
      Swal.fire({ icon: 'error', title: 'Error', text: result.message, background: '#1e1b4b', color: '#fff' });
    }
  } catch (err) {
    Swal.fire({ icon: 'error', title: 'Network Error', text: err.message, background: '#1e1b4b', color: '#fff' });
  }
});
</script>

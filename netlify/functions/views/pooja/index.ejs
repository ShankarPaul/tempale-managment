<!-- Header & Filter Tabs -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
  <div class="flex flex-wrap gap-2">
    <% ['','Confirmed','Completed','Cancelled'].forEach((s) => { %>
    <a href="/pooja<%= s ? '?status='+s : '' %>" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all <%= (filters.status||'')===(s) ? 'bg-amber-500 text-white shadow-lg shadow-amber-500/20' : 'bg-white/5 border border-white/10 text-white/70 hover:bg-white/10 hover:text-white' %>">
      <%= s || 'All Bookings' %>
    </a>
    <% }); %>
  </div>
  <button onclick="document.getElementById('addBookingModal').classList.add('active')" class="btn-primary text-sm">
    <i class="ph-bold ph-plus text-base"></i>
    <span>New Booking</span>
  </button>
</div>

<!-- Bookings List -->
<div class="space-y-4">
  <% if(bookings.length === 0) { %>
    <div class="glass p-16 text-center text-white/40 rounded-2xl">
      <div class="w-16 h-16 rounded-2xl bg-amber-500/10 flex items-center justify-center mx-auto mb-3 text-amber-400">
        <i class="ph-duotone ph-flower-lotus text-4xl"></i>
      </div>
      <p class="text-base font-semibold text-white/80">No pooja bookings found</p>
      <p class="text-xs text-white/40 mt-1">Click "New Booking" to schedule a pooja or archana for devotees.</p>
    </div>
  <% } %>

  <% bookings.forEach(b => {
    const statusColorMap = {
      'Confirmed': 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30',
      'Completed': 'bg-blue-500/15 text-blue-300 border-blue-500/30',
      'Pending': 'bg-amber-500/15 text-amber-300 border-amber-500/30',
      'Cancelled': 'bg-rose-500/15 text-rose-300 border-rose-500/30'
    };
    const badgeClass = statusColorMap[b.status] || 'bg-white/10 text-white/70 border-white/20';
  %>
  <div class="glass-card p-5 rounded-2xl transition-all">
    <div class="flex flex-col sm:flex-row justify-between items-start gap-4">
      <div class="flex items-start gap-4">
        <!-- Date Badge -->
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-500/20 to-orange-500/30 border border-amber-500/30 flex flex-col items-center justify-center text-amber-300 flex-shrink-0 shadow-inner">
          <span class="text-base font-bold font-mono leading-none"><%= new Date(b.booking_date).getDate() %></span>
          <span class="text-[10px] uppercase tracking-wider text-amber-300/70 mt-1"><%= new Date(b.booking_date).toLocaleString('en-IN', {month:'short'}) %></span>
        </div>

        <div>
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <h4 class="font-bold text-white text-base leading-tight"><%= b.devotee_name %></h4>
            <span class="px-2 py-0.5 rounded-full text-xs font-medium border <%= badgeClass %>"><%= b.status %></span>
          </div>

          <p class="text-amber-400 font-semibold text-xs flex items-center gap-1">
            <i class="ph-duotone ph-flower-lotus text-sm"></i>
            <span><%= b.pooja_type %></span>
          </p>

          <div class="flex flex-wrap gap-x-4 gap-y-1.5 mt-2.5 text-xs text-white/50">
            <% if(b.devotee_phone) { %>
              <span class="flex items-center gap-1"><i class="ph-duotone ph-phone"></i> <%= b.devotee_phone %></span>
            <% } %>
            <% if(b.gotra) { %>
              <span class="flex items-center gap-1"><i class="ph-duotone ph-tree-structure"></i> Gotra: <%= b.gotra %></span>
            <% } %>
            <% if(b.pooja_time) { %>
              <span class="flex items-center gap-1"><i class="ph-duotone ph-clock"></i> <%= b.pooja_time %></span>
            <% } %>
            <span class="flex items-center gap-1"><i class="ph-duotone ph-user"></i> Priest: <%= b.priest_name || 'To be assigned' %></span>
            <span class="flex items-center gap-1 font-mono text-white/40"><i class="ph-duotone ph-hash"></i> <%= b.booking_number %></span>
          </div>
        </div>
      </div>

      <!-- Fees & Action Buttons -->
      <div class="flex flex-col sm:items-end gap-2.5 w-full sm:w-auto pt-3 sm:pt-0 border-t sm:border-t-0 border-white/10">
        <div class="text-left sm:text-right">
          <p class="text-[11px] text-white/40 uppercase tracking-wider">Booking Fee</p>
          <p class="font-bold text-white text-base font-mono">₹<%= parseFloat(b.booking_fee || 0).toLocaleString('en-IN') %></p>
          <% if(parseFloat(b.advance_paid || 0) > 0) { %>
            <p class="text-xs text-emerald-400 font-mono">Advance: ₹<%= parseFloat(b.advance_paid).toLocaleString('en-IN') %></p>
          <% } %>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <a href="/pooja/<%= b.id %>/slip" target="_blank" class="px-3 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/20 text-xs font-semibold flex items-center gap-1.5 transition-colors">
            <i class="ph-bold ph-printer"></i>
            <span>Slip</span>
          </a>
          <% if(b.status === 'Confirmed') { %>
            <button onclick="updateStatus(<%= b.id %>, 'Completed')" class="px-3 py-1.5 rounded-xl bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 border border-emerald-500/30 text-xs font-semibold flex items-center gap-1 transition-colors">
              <i class="ph-bold ph-check"></i> Complete
            </button>
            <button onclick="updateStatus(<%= b.id %>, 'Cancelled')" class="px-3 py-1.5 rounded-xl bg-rose-500/15 hover:bg-rose-500/25 text-rose-300 border border-rose-500/30 text-xs font-semibold flex items-center gap-1 transition-colors">
              <i class="ph-bold ph-x"></i> Cancel
            </button>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <% }); %>
</div>

<!-- Add Booking Modal -->
<div class="modal-overlay" id="addBookingModal">
  <div class="modal-box max-w-2xl w-full">
    <div class="flex justify-between items-center mb-5 pb-3 border-b border-white/10">
      <div class="flex items-center gap-2">
        <div class="w-9 h-9 rounded-xl bg-amber-500/20 flex items-center justify-center text-amber-400">
          <i class="ph-duotone ph-flower-lotus text-xl"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-white">New Pooja Booking</h3>
          <p class="text-xs text-white/40">Register devotee pooja, havan or ritual schedule</p>
        </div>
      </div>
      <button onclick="document.getElementById('addBookingModal').classList.remove('active')" class="text-white/40 hover:text-white transition-colors">
        <i class="ph-bold ph-x text-lg"></i>
      </button>
    </div>

    <form id="addBookingForm" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="form-label">Devotee Name *</label>
        <input type="text" name="devotee_name" required class="form-input" placeholder="e.g. Rajesh Sharma">
      </div>
      <div>
        <label class="form-label">Phone Number</label>
        <input type="tel" name="devotee_phone" class="form-input" placeholder="e.g. 9876543210">
      </div>
      <div>
        <label class="form-label">Gotra</label>
        <input type="text" name="gotra" class="form-input" placeholder="e.g. Kashyap, Bhardwaj">
      </div>
      <div>
        <label class="form-label">Pooja Type *</label>
        <select name="pooja_type" required class="form-input">
          <option value="">Select pooja...</option>
          <option>Satyanarayan Katha</option>
          <option>Havan</option>
          <option>Rudrabhishek</option>
          <option>Vehicle Pooja</option>
          <option>Gruhapravesh</option>
          <option>Naamkaran</option>
          <option>Mundan</option>
          <option>Vivah Pooja</option>
          <option>Navgrah Pooja</option>
          <option>Kanya Pooja</option>
          <option>Special Archana</option>
          <option>Custom</option>
        </select>
      </div>
      <div>
        <label class="form-label">Booking Date *</label>
        <input type="date" name="booking_date" required class="form-input" value="<%= new Date().toISOString().split('T')[0] %>">
      </div>
      <div>
        <label class="form-label">Pooja Time</label>
        <input type="time" name="pooja_time" class="form-input">
      </div>
      <div>
        <label class="form-label">Assign Priest</label>
        <select name="assigned_priest_id" class="form-input">
          <option value="">To be assigned</option>
          <% priests.forEach(p => { %>
            <option value="<%= p.id %>"><%= p.name %></option>
          <% }); %>
        </select>
      </div>
      <div>
        <label class="form-label">Booking Fee (₹)</label>
        <input type="number" name="booking_fee" class="form-input font-mono" placeholder="0" min="0">
      </div>
      <div>
        <label class="form-label">Advance Paid (₹)</label>
        <input type="number" name="advance_paid" class="form-input font-mono" placeholder="0" min="0">
      </div>
      <div>
        <label class="form-label">Special Requirements</label>
        <input type="text" name="special_requirements" class="form-input" placeholder="Samagri, flowers, etc.">
      </div>
      <div class="col-span-1 sm:col-span-2">
        <label class="form-label">Address (if at home / external location)</label>
        <textarea name="address" class="form-input h-16 resize-none" placeholder="Devotee residence or hall address"></textarea>
      </div>
      <div class="col-span-1 sm:col-span-2 flex gap-3 pt-2">
        <button type="submit" class="btn-primary flex-1 justify-center">
          <i class="ph-bold ph-check-circle text-base"></i>
          <span>Confirm Booking</span>
        </button>
        <button type="button" onclick="document.getElementById('addBookingModal').classList.remove('active')" class="btn-secondary">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>

<script>
document.getElementById('addBookingForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(this));
  try {
    const res = await fetch('/pooja', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(data)
    });
    const result = await res.json();
    if (result.success) {
      document.getElementById('addBookingModal').classList.remove('active');
      Swal.fire({
        icon: 'success',
        title: 'Booking Confirmed!',
        text: `Booking No: ${result.booking.booking_number}`,
        showCancelButton: true,
        confirmButtonText: '🖨️ Print Slip',
        cancelButtonText: 'Done',
        confirmButtonColor: '#f59e0b',
        background: '#1e1b4b',
        color: '#fff'
      }).then(r => {
        if(r.isConfirmed) window.open(`/pooja/${result.booking.id}/slip`, '_blank');
        location.reload();
      });
    } else {
      Swal.fire({ icon: 'error', title: 'Error', text: result.message, background: '#1e1b4b', color: '#fff' });
    }
  } catch (err) {
    Swal.fire({ icon: 'error', title: 'Network Error', text: err.message, background: '#1e1b4b', color: '#fff' });
  }
});

async function updateStatus(id, status) {
  try {
    const res = await fetch(`/pooja/${id}/status`, {
      method: 'PUT',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ status })
    });
    const result = await res.json();
    if (result.success) {
      showToast(`Booking marked as ${status}`);
      setTimeout(() => location.reload(), 800);
    } else {
      Swal.fire({ icon: 'error', title: 'Error', text: result.message, background: '#1e1b4b', color: '#fff' });
    }
  } catch (err) {
    Swal.fire({ icon: 'error', title: 'Network Error', text: err.message, background: '#1e1b4b', color: '#fff' });
  }
}
</script>

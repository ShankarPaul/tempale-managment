<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Donation Receipt — <%= receipt.receipt_number %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { font-family: 'Plus Jakarta Sans', sans-serif; }
    @media print {
      button { display: none !important; }
      body { margin: 0; padding: 0; }
    }
  </style>
</head>
<body class="p-6 max-w-2xl mx-auto bg-slate-50 text-slate-800 min-h-screen">
  <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-xl">
    <!-- Header -->
    <div class="bg-gradient-to-r from-amber-600 to-amber-700 text-white p-6">
      <div class="flex justify-between items-start">
        <div>
          <div class="text-3xl mb-1">🕉️</div>
          <h1 class="text-xl font-bold tracking-tight">SHRI MANDIR TRUST</h1>
          <p class="text-amber-200 text-xs">Tax-Exempt Religious Trust | Reg. No. TR/2022/981</p>
        </div>
        <div class="text-right">
          <div class="text-lg font-bold font-mono bg-white/15 backdrop-blur text-white px-3.5 py-1.5 rounded-xl border border-white/20">
            <%= receipt.receipt_number %>
          </div>
          <p class="text-amber-200 text-[11px] mt-1 font-semibold uppercase tracking-wider">
            <% if(type === 'cash') { %>Donation Receipt<% } else { %>Commodity Donation Receipt<% } %>
          </p>
        </div>
      </div>
    </div>

    <!-- Body -->
    <div class="p-6 space-y-4">
      <div class="bg-amber-50/70 rounded-xl p-4 border border-amber-100">
        <p class="text-amber-800 text-xs font-bold uppercase tracking-wider mb-2">🙏 Received with gratitude from:</p>
        <div class="grid grid-cols-2 gap-2.5 text-xs">
          <div><span class="text-slate-500">Name:</span><br><strong class="text-slate-800 text-sm"><%= receipt.donor_name %></strong></div>
          <div><span class="text-slate-500">Phone:</span><br><strong class="text-slate-800 text-sm"><%= receipt.donor_phone || 'N/A' %></strong></div>
          <% if(receipt.address) { %><div class="col-span-2"><span class="text-slate-500">Address:</span><br><strong class="text-slate-800"><%= receipt.address %></strong></div><% } %>
          <% if(receipt.pan_number) { %><div><span class="text-slate-500">PAN:</span><br><strong class="text-slate-800 font-mono"><%= receipt.pan_number %></strong></div><% } %>
        </div>
      </div>

      <% if(type === 'cash') { %>
      <!-- Cash Donation Details -->
      <table class="w-full text-xs border-collapse">
        <tr class="bg-slate-50"><td class="p-3 border border-slate-200 font-semibold text-slate-600">Amount in Words</td>
          <td class="p-3 border border-slate-200 font-bold text-slate-800">₹<%= parseFloat(receipt.amount).toLocaleString('en-IN') %> (Rupees Only)</td></tr>
        <tr><td class="p-3 border border-slate-200 font-semibold text-slate-600">Payment Mode</td>
          <td class="p-3 border border-slate-200"><strong class="text-amber-700 font-semibold"><%= receipt.payment_mode %></strong></td></tr>
        <% if(receipt.transaction_ref) { %><tr><td class="p-3 border border-slate-200 font-semibold text-slate-600">Reference / UTR</td><td class="p-3 border border-slate-200 font-mono"><%= receipt.transaction_ref %></td></tr><% } %>
        <% if(receipt.cheque_number) { %><tr><td class="p-3 border border-slate-200 font-semibold text-slate-600">Cheque No.</td><td class="p-3 border border-slate-200 font-mono"><%= receipt.cheque_number %></td></tr><% } %>
        <tr><td class="p-3 border border-slate-200 font-semibold text-slate-600">Date</td>
          <td class="p-3 border border-slate-200 font-medium"><%= new Date(receipt.donation_date).toLocaleDateString('en-IN', {day:'numeric',month:'long',year:'numeric'}) %></td></tr>
        <% if(receipt.purpose) { %><tr><td class="p-3 border border-slate-200 font-semibold text-slate-600">Purpose</td><td class="p-3 border border-slate-200"><%= receipt.purpose %></td></tr><% } %>
        <tr class="bg-emerald-600 text-white"><td class="p-4 font-bold text-sm uppercase tracking-wider">TOTAL DONATION</td>
          <td class="p-4 font-bold text-2xl font-mono">₹<%= parseFloat(receipt.amount).toLocaleString('en-IN') %></td></tr>
      </table>
      <% if(receipt.is_80g) { %>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-3.5 text-xs text-blue-800">
        <strong>📋 80G Tax Exemption:</strong> This contribution qualifies for deduction under Section 80G of the Income Tax Act, 1961. 80G Certificate will be generated for the financial year.
      </div>
      <% } %>

      <% } else { %>
      <!-- Commodity Donation Details -->
      <table class="w-full text-xs border-collapse">
        <tr class="bg-slate-50"><td class="p-3 border border-slate-200 font-semibold text-slate-600">Item Donated</td><td class="p-3 border border-slate-200 font-bold text-slate-800 text-sm"><%= receipt.item_name %></td></tr>
        <tr><td class="p-3 border border-slate-200 font-semibold text-slate-600">Quantity</td><td class="p-3 border border-slate-200 font-bold text-amber-700 text-base font-mono"><%= parseFloat(receipt.quantity) %> <%= receipt.unit %></td></tr>
        <% if(receipt.estimated_value) { %><tr><td class="p-3 border border-slate-200 font-semibold text-slate-600">Estimated Value</td><td class="p-3 border border-slate-200 font-mono">₹<%= parseFloat(receipt.estimated_value).toLocaleString('en-IN') %></td></tr><% } %>
        <tr><td class="p-3 border border-slate-200 font-semibold text-slate-600">Date</td><td class="p-3 border border-slate-200"><%= new Date(receipt.donation_date).toLocaleDateString('en-IN', {day:'numeric',month:'long',year:'numeric'}) %></td></tr>
        <% if(receipt.notes) { %><tr><td class="p-3 border border-slate-200 font-semibold text-slate-600">Notes</td><td class="p-3 border border-slate-200"><%= receipt.notes %></td></tr><% } %>
      </table>
      <% } %>
    </div>

    <!-- Signatures & Footer -->
    <div class="p-6 border-t border-slate-200 grid grid-cols-2 gap-8 text-center text-xs">
      <div><div class="border-t-2 border-dashed border-slate-300 mt-10 pt-2 text-slate-500 font-medium">Donor Signature</div></div>
      <div><div class="border-t-2 border-dashed border-slate-300 mt-10 pt-2 text-slate-500 font-medium">Authorized Trustee</div></div>
    </div>
    <div class="bg-amber-50/70 p-3 text-center text-[11px] text-amber-800 border-t border-amber-100">
      🙏 May your noble contribution bring prosperity and peace | Generated on <%= new Date().toLocaleDateString('en-IN') %>
    </div>
  </div>

  <div class="text-center mt-6 space-x-3">
    <button onclick="window.print()" class="bg-amber-600 text-white px-6 py-2.5 rounded-xl font-semibold hover:bg-amber-700 shadow-md transition-colors text-sm">🖨️ Print Receipt</button>
    <button onclick="window.close()" class="bg-slate-200 text-slate-700 px-6 py-2.5 rounded-xl font-semibold hover:bg-slate-300 transition-colors text-sm">Close</button>
  </div>
</body>
</html>

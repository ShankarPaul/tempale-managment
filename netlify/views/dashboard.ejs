<!-- Stats Grid -->
<div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 mb-6">
  <%
  const statItems = [
    { icon: 'ph-duotone ph-users', label: 'Active Staff', value: stats.totalStaff, color: 'from-blue-500 to-blue-600', glow: 'rgba(59,130,246,0.3)' },
    { icon: 'ph-duotone ph-hand-heart', label: 'Monthly Donations', value: '₹'+stats.monthlyDonations, color: 'from-green-500 to-emerald-600', glow: 'rgba(34,197,94,0.3)' },
    { icon: 'ph-duotone ph-receipt', label: 'Monthly Expenses', value: '₹'+stats.monthlyExpenses, color: 'from-red-500 to-rose-600', glow: 'rgba(239,68,68,0.3)' },
    { icon: 'ph-duotone ph-wallet', label: 'Cash Balance', value: '₹'+stats.cashBalance, color: 'from-amber-500 to-orange-500', glow: 'rgba(251,191,36,0.3)' },
    { icon: 'ph-duotone ph-package', label: 'Low Stock Items', value: stats.lowStockCount, color: parseInt(stats.lowStockCount) > 0 ? 'from-orange-500 to-red-500' : 'from-teal-500 to-cyan-600', glow: 'rgba(249,115,22,0.3)' },
    { icon: 'ph-duotone ph-flower-lotus', label: 'Upcoming Poojas', value: stats.upcomingBookings, color: 'from-purple-500 to-violet-600', glow: 'rgba(139,92,246,0.3)' },
  ];
  %>
  <% statItems.forEach(s => { %>
  <div class="glass-card stat-card p-5 animate-slide-up">
    <div class="w-11 h-11 rounded-2xl bg-gradient-to-br <%= s.color %> flex items-center justify-center mb-4" style="box-shadow: 0 6px 20px <%= s.glow %>">
      <i class="<%= s.icon %> text-white text-xl"></i>
    </div>
    <p class="text-2xl font-extrabold text-white leading-tight"><%= s.value %></p>
    <p class="text-xs text-white/40 font-medium mt-1"><%= s.label %></p>
  </div>
  <% }); %>
</div>

<!-- Charts + Alerts Row -->
<div class="grid grid-cols-1 xl:grid-cols-3 gap-5 mb-5">
  <!-- Income vs Expense Chart -->
  <div class="glass-card p-6 xl:col-span-2">
    <div class="flex justify-between items-center mb-5">
      <div>
        <h3 class="font-bold text-white text-base">Income vs Expense</h3>
        <p class="text-white/40 text-xs mt-0.5">Last 6 months overview</p>
      </div>
      <a href="/reports" class="text-amber-400 text-xs font-semibold hover:text-amber-300 flex items-center gap-1">
        View Reports <i class="ph-bold ph-arrow-right"></i>
      </a>
    </div>
    <canvas id="trendChart" height="100"></canvas>
  </div>

  <!-- Low Stock Alerts -->
  <div class="glass-card p-6">
    <div class="flex justify-between items-center mb-4">
      <h3 class="font-bold text-white text-base">Stock Alerts</h3>
      <% if(parseInt(stats.lowStockCount) > 0) { %>
      <span class="badge badge-red"><%= stats.lowStockCount %> Low</span>
      <% } else { %>
      <span class="badge badge-green">All OK</span>
      <% } %>
    </div>
    <% if(lowStockItems.length === 0) { %>
      <div class="flex flex-col items-center justify-center py-8 text-center">
        <div class="w-12 h-12 rounded-full bg-green-500/10 flex items-center justify-center mb-3">
          <i class="ph-bold ph-check-circle text-green-400 text-2xl"></i>
        </div>
        <p class="text-white/50 text-sm">All stock levels healthy</p>
      </div>
    <% } else { %>
      <div class="space-y-3 max-h-52 overflow-y-auto pr-1">
        <% lowStockItems.forEach(item => {
          const pct = Math.max(5, Math.min(100, (item.current_stock / (item.min_buffer_stock * 3)) * 100));
        %>
        <div class="glass rounded-xl p-3">
          <div class="flex justify-between items-center mb-1.5">
            <div>
              <p class="text-white/85 text-sm font-semibold leading-tight"><%= item.item_name %></p>
              <p class="text-white/30 text-xs"><%= item.category %></p>
            </div>
            <span class="text-red-400 font-bold text-sm"><%= parseFloat(item.current_stock).toFixed(1) %> <span class="text-white/30 font-normal text-xs"><%= item.unit %></span></span>
          </div>
          <div class="w-full bg-white/10 rounded-full h-1.5">
            <div class="bg-red-500 h-1.5 rounded-full transition-all" style="width:<%= pct %>%"></div>
          </div>
        </div>
        <% }); %>
      </div>
      <a href="/inventory" class="mt-3 flex items-center gap-1 text-amber-400 text-xs font-semibold hover:text-amber-300">
        Manage Inventory <i class="ph-bold ph-arrow-right"></i>
      </a>
    <% } %>
  </div>
</div>

<!-- Bottom Row -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
  <!-- Recent Donations -->
  <div class="glass-card p-6">
    <div class="flex justify-between items-center mb-4">
      <h3 class="font-bold text-white text-base">Recent Donations</h3>
      <a href="/donations" class="text-amber-400 text-xs font-semibold hover:text-amber-300">View All</a>
    </div>
    <div class="space-y-3">
      <% if(!recentDonations.length) { %><p class="text-white/30 text-sm text-center py-6">No donations yet</p><% } %>
      <% recentDonations.forEach(d => { %>
      <div class="flex items-center justify-between p-3 rounded-xl hover:bg-white/5 transition-colors">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
            <%= d.donor_name.charAt(0).toUpperCase() %>
          </div>
          <div>
            <p class="font-semibold text-white/90 text-sm leading-tight"><%= d.donor_name.substring(0,18) %><%= d.donor_name.length>18?'...':'' %></p>
            <p class="text-white/30 text-xs"><%= d.payment_mode %> · <%= new Date(d.donation_date).toLocaleDateString('en-IN') %></p>
          </div>
        </div>
        <span class="text-green-400 font-bold text-sm">₹<%= parseFloat(d.amount).toLocaleString('en-IN') %></span>
      </div>
      <% }); %>
    </div>
  </div>

  <!-- Recent Expenses -->
  <div class="glass-card p-6">
    <div class="flex justify-between items-center mb-4">
      <h3 class="font-bold text-white text-base">Recent Expenses</h3>
      <a href="/expenses" class="text-amber-400 text-xs font-semibold hover:text-amber-300">View All</a>
    </div>
    <div class="space-y-3">
      <% if(!recentExpenses.length) { %><p class="text-white/30 text-sm text-center py-6">No expenses yet</p><% } %>
      <% recentExpenses.forEach(e => { %>
      <div class="flex items-center justify-between p-3 rounded-xl hover:bg-white/5 transition-colors">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-red-500/15 flex items-center justify-center flex-shrink-0">
            <i class="ph-duotone ph-receipt text-red-400 text-base"></i>
          </div>
          <div>
            <p class="text-white/85 text-sm font-semibold leading-tight"><%= e.description.substring(0,22) %><%= e.description.length>22?'...':'' %></p>
            <span class="badge badge-amber text-xs"><%= e.category %></span>
          </div>
        </div>
        <span class="text-red-400 font-bold text-sm">₹<%= parseFloat(e.amount).toLocaleString('en-IN') %></span>
      </div>
      <% }); %>
    </div>
  </div>

  <!-- Upcoming Poojas -->
  <div class="glass-card p-6">
    <div class="flex justify-between items-center mb-4">
      <h3 class="font-bold text-white text-base">Upcoming Poojas</h3>
      <a href="/pooja" class="text-amber-400 text-xs font-semibold hover:text-amber-300">View All</a>
    </div>
    <div class="space-y-3">
      <% if(!upcomingBookings.length) { %>
        <div class="text-center py-8">
          <i class="ph-duotone ph-flower-lotus text-3xl text-white/20"></i>
          <p class="text-white/30 text-sm mt-2">No upcoming bookings</p>
        </div>
      <% } else { %>
        <% upcomingBookings.forEach(b => { %>
        <div class="glass rounded-xl p-3 border border-purple-500/20">
          <div class="flex justify-between items-start">
            <div>
              <p class="text-white/90 font-semibold text-sm"><%= b.devotee_name %></p>
              <p class="text-purple-300 text-xs font-medium mt-0.5">🕉️ <%= b.pooja_type %></p>
              <p class="text-white/30 text-xs mt-1">👤 <%= b.priest_name || 'TBD' %></p>
            </div>
            <div class="text-right flex-shrink-0">
              <p class="text-white/60 text-xs font-bold"><%= new Date(b.booking_date).toLocaleDateString('en-IN') %></p>
              <% if(b.pooja_time) { %><p class="text-white/30 text-xs"><%= b.pooja_time %></p><% } %>
            </div>
          </div>
        </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</div>

<script>
Chart.defaults.color = 'rgba(255,255,255,0.4)';
Chart.defaults.borderColor = 'rgba(255,255,255,0.06)';

const trendData = <%- monthlyData %>;
const ctx = document.getElementById('trendChart').getContext('2d');

const incomeGrad = ctx.createLinearGradient(0, 0, 0, 200);
incomeGrad.addColorStop(0, 'rgba(34,197,94,0.4)');
incomeGrad.addColorStop(1, 'rgba(34,197,94,0)');

const expGrad = ctx.createLinearGradient(0, 0, 0, 200);
expGrad.addColorStop(0, 'rgba(239,68,68,0.4)');
expGrad.addColorStop(1, 'rgba(239,68,68,0)');

new Chart(ctx, {
  type: 'line',
  data: {
    labels: trendData.length ? trendData.map(d => d.month) : ['No Data'],
    datasets: [
      { label: 'Donations ₹', data: trendData.map(d => parseFloat(d.income)||0), borderColor: '#22c55e', backgroundColor: incomeGrad, fill: true, tension: 0.4, borderWidth: 2.5, pointRadius: 4, pointBackgroundColor: '#22c55e', pointBorderColor: '#fff', pointBorderWidth: 2 },
      { label: 'Expenses ₹', data: trendData.map(d => parseFloat(d.income)*0.4||0), borderColor: '#ef4444', backgroundColor: expGrad, fill: true, tension: 0.4, borderWidth: 2.5, pointRadius: 4, pointBackgroundColor: '#ef4444', pointBorderColor: '#fff', pointBorderWidth: 2 }
    ]
  },
  options: {
    responsive: true,
    plugins: { legend: { labels: { color: 'rgba(255,255,255,0.5)', font: { family: 'Plus Jakarta Sans', size: 12 }, boxWidth: 12, usePointStyle: true } } },
    scales: {
      y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: 'rgba(255,255,255,0.4)', font: { size: 11 } } },
      x: { grid: { display: false }, ticks: { color: 'rgba(255,255,255,0.4)', font: { size: 11 } } }
    }
  }
});
</script>

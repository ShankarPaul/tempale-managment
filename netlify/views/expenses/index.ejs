<!-- Header Controls -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
  <form method="GET" class="flex items-center gap-3">
    <div class="relative">
      <input type="month" name="month" value="<%= month %>" class="form-input text-sm font-medium py-2 px-3 pr-8 cursor-pointer" onchange="this.form.submit()">
    </div>
  </form>
  <div class="flex items-center gap-3">
    <a href="/expenses/daybook" class="btn-secondary text-sm">
      <i class="ph-duotone ph-notebook text-lg"></i>
      <span>Daybook</span>
    </a>
    <button onclick="document.getElementById('addExpenseModal').classList.add('active')" class="btn-primary text-sm">
      <i class="ph-bold ph-plus text-base"></i>
      <span>Add Expense</span>
    </button>
  </div>
</div>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-6">
  <!-- Category Summary Card -->
  <div class="glass p-6 rounded-2xl flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-bold text-white text-base flex items-center gap-2">
          <i class="ph-duotone ph-chart-pie-slice text-amber-400 text-xl"></i>
          <span>By Category</span>
        </h3>
        <span class="text-xs text-white/40"><%= summary.length %> Categories</span>
      </div>

      <div class="space-y-3.5">
        <% const totalExp = summary.reduce((a,b) => a + parseFloat(b.total), 0); %>
        <% if (summary.length === 0) { %>
          <div class="text-center py-8 text-white/40">
            <i class="ph-duotone ph-receipt text-3xl mb-1 text-white/20"></i>
            <p class="text-xs">No expenses in this month</p>
          </div>
        <% } else { %>
          <% summary.forEach(cat => {
            const pct = totalExp > 0 ? (parseFloat(cat.total) / totalExp * 100).toFixed(1) : 0;
          %>
          <div>
            <div class="flex justify-between text-xs mb-1.5">
              <span class="font-medium text-white/80"><%= cat.category %></span>
              <span class="text-white/50 font-mono">₹<%= parseFloat(cat.total).toLocaleString('en-IN') %> <span class="text-amber-400/80">(<%= pct %>%)</span></span>
            </div>
            <div class="w-full bg-white/5 rounded-full h-1.5 overflow-hidden">
              <div class="bg-gradient-to-r from-amber-500 to-orange-500 h-1.5 rounded-full transition-all duration-500" style="width:<%= pct %>%"></div>
            </div>
          </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <div class="pt-4 mt-4 border-t border-white/10 flex justify-between items-center">
      <span class="text-xs uppercase tracking-wider text-white/50 font-bold">Total Expenses</span>
      <span class="text-lg font-bold text-red-400 font-mono">₹<%= totalExp.toLocaleString('en-IN') %></span>
    </div>
  </div>

  <!-- Expenses List -->
  <div class="glass overflow-hidden xl:col-span-2 rounded-2xl flex flex-col">
    <div class="p-4 sm:p-5 border-b border-white/10 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <i class="ph-duotone ph-receipt text-amber-400 text-lg"></i>
        <h3 class="font-bold text-white text-base">
          All Expenses — <%= new Date(month + '-01').toLocaleString('en-IN', {month:'long', year:'numeric'}) %>
        </h3>
      </div>
      <span class="text-xs px-2.5 py-1 rounded-full bg-white/10 text-white/70 font-mono"><%= expenses.length %> entries</span>
    </div>

    <div class="overflow-x-auto flex-1">
      <% if (expenses.length === 0) { %>
        <div class="text-center py-16 text-white/40">
          <div class="w-16 h-16 rounded-2xl bg-white/5 flex items-center justify-center mx-auto mb-3">
            <i class="ph-duotone ph-receipt text-3xl text-amber-400/60"></i>
          </div>
          <p class="text-base font-semibold text-white/70">No expenses recorded for this month</p>
          <p class="text-xs text-white/40 mt-1">Click "Add Expense" to track temple utilities, maintenance, or supplies.</p>
        </div>
      <% } else { %>
        <table class="w-full text-sm">
          <thead class="bg-white/5 border-b border-white/10 sticky top-0">
            <tr>
              <th class="text-left px-4 py-3 text-xs font-semibold text-white/50 uppercase tracking-wider">Date</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-white/50 uppercase tracking-wider">Category</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-white/50 uppercase tracking-wider">Description</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-white/50 uppercase tracking-wider">Mode</th>
              <th class="text-right px-4 py-3 text-xs font-semibold text-white/50 uppercase tracking-wider">Amount</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <% expenses.forEach(e => { %>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="px-4 py-3.5 text-white/60 text-xs whitespace-nowrap font-mono">
                <%= new Date(e.expense_date).toLocaleDateString('en-IN') %>
              </td>
              <td class="px-4 py-3.5">
                <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-amber-500/15 text-amber-300 border border-amber-500/20">
                  <%= e.category %>
                </span>
              </td>
              <td class="px-4 py-3.5 text-white/90 max-w-xs truncate text-xs">
                <%= e.description %>
              </td>
              <td class="px-4 py-3.5 text-white/50 text-xs">
                <%= e.payment_mode || 'Cash' %>
              </td>
              <td class="px-4 py-3.5 text-right font-bold text-red-400 font-mono whitespace-nowrap">
                ₹<%= parseFloat(e.amount).toLocaleString('en-IN') %>
              </td>
              <td class="px-4 py-3.5 text-right">
                <button onclick="deleteExpense(<%= e.id %>)" class="w-8 h-8 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 flex items-center justify-center transition-colors inline-flex" title="Delete Expense">
                  <i class="ph-bold ph-trash text-sm"></i>
                </button>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>

<!-- Add Expense Modal -->
<div class="modal-overlay" id="addExpenseModal">
  <div class="modal-box max-w-md w-full">
    <div class="flex justify-between items-center mb-5 pb-3 border-b border-white/10">
      <div class="flex items-center gap-2">
        <div class="w-9 h-9 rounded-xl bg-amber-500/20 flex items-center justify-center text-amber-400">
          <i class="ph-duotone ph-receipt text-xl"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-white">Record New Expense</h3>
          <p class="text-xs text-white/40">Enter temple operational or ritual expenses</p>
        </div>
      </div>
      <button onclick="document.getElementById('addExpenseModal').classList.remove('active')" class="text-white/40 hover:text-white transition-colors">
        <i class="ph-bold ph-x text-lg"></i>
      </button>
    </div>

    <form id="addExpenseForm" class="space-y-4">
      <div>
        <label class="form-label">Date *</label>
        <input type="date" name="expense_date" required class="form-input" value="<%= new Date().toISOString().split('T')[0] %>">
      </div>
      <div>
        <label class="form-label">Category *</label>
        <select name="category" required class="form-input">
          <option>Electricity</option>
          <option>Pooja Samagri</option>
          <option>Maintenance</option>
          <option>Gas/Fuel</option>
          <option>Cleaning</option>
          <option>Food/Prasad</option>
          <option>Security</option>
          <option>Decoration</option>
          <option>Transport</option>
          <option>Medical</option>
          <option>Salaries</option>
          <option>Miscellaneous</option>
        </select>
      </div>
      <div>
        <label class="form-label">Description *</label>
        <textarea name="description" required placeholder="e.g. Monthly electricity bill for sanctum sanctorum..." class="form-input h-20 resize-none"></textarea>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="form-label">Amount (₹) *</label>
          <input type="number" name="amount" required min="1" placeholder="0" class="form-input font-mono">
        </div>
        <div>
          <label class="form-label">Payment Mode</label>
          <select name="payment_mode" class="form-input">
            <option>Cash</option>
            <option>UPI</option>
            <option>Card</option>
            <option>Net Banking</option>
          </select>
        </div>
      </div>
      <div>
        <label class="form-label">Approved By</label>
        <input type="text" name="approved_by" placeholder="e.g. Temple Trustee / Head Priest" class="form-input">
      </div>
      <div class="flex gap-3 pt-2">
        <button type="submit" class="btn-primary flex-1 justify-center">
          <i class="ph-bold ph-floppy-disk text-base"></i>
          <span>Save Expense</span>
        </button>
        <button type="button" onclick="document.getElementById('addExpenseModal').classList.remove('active')" class="btn-secondary">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>

<script>
document.getElementById('addExpenseForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(this));
  try {
    const res = await fetch('/expenses', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(data)
    });
    const result = await res.json();
    if (result.success) {
      showToast('Expense recorded successfully!');
      setTimeout(() => location.reload(), 800);
    } else {
      Swal.fire({ icon: 'error', title: 'Error', text: result.message, background: '#1e1b4b', color: '#fff' });
    }
  } catch (err) {
    Swal.fire({ icon: 'error', title: 'Network Error', text: err.message, background: '#1e1b4b', color: '#fff' });
  }
});

async function deleteExpense(id) {
  const { isConfirmed } = await Swal.fire({
    title: 'Delete Expense?',
    text: 'This will permanently remove this expense record.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#ef4444',
    confirmButtonText: 'Yes, Delete',
    background: '#1e1b4b',
    color: '#fff'
  });
  if (!isConfirmed) return;
  try {
    const res = await fetch(`/expenses/${id}`, { method: 'DELETE' });
    const result = await res.json();
    if (result.success) {
      showToast('Expense deleted');
      setTimeout(() => location.reload(), 600);
    } else {
      Swal.fire({ icon: 'error', title: 'Error', text: result.message, background: '#1e1b4b', color: '#fff' });
    }
  } catch (err) {
    Swal.fire({ icon: 'error', title: 'Network Error', text: err.message, background: '#1e1b4b', color: '#fff' });
  }
}
</script>
